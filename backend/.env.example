# Переменные API для локальной разработки. `make env` копирует файл в backend/.env и подставляет
# DATABASE_URL со случайным паролем dev-базы. Значений секретов в репозитории быть не должно.

APP_ENV=development
# Адрес API; пусто — 127.0.0.1:8088
PORT=
# Пусто в development — API стартует без базы, health отдаёт db: down
DATABASE_URL=
# Пусто в development — http://localhost:5177 (Vite)
PUBLIC_ORIGIN=
# IP или CIDR обратного прокси через запятую; в development не нужен
TRUSTED_PROXIES=

# --- Поиск ---
# Адреса сервисов: строка не задана (закомментирована) — в development локальный адрес по умолчанию
# (OpenSearch http://127.0.0.1:9201, модели http://127.0.0.1:8089); пусто или off — сервис выключен.
# OPENSEARCH_URL=
# EMBEDDER_URL=
# RERANKER_URL=
# Каталог mock-данных для импорта; по умолчанию ../data/mock
# DATA_DIR=

# --- LLM (Yandex AI Studio, OpenAI-совместимый API) ---
# openai-compatible | none; пусто — openai-compatible, если задан ключ
LLM_PROVIDER=
# По умолчанию https://ai.api.cloud.yandex.net/v1
LLM_BASE_URL=
# По умолчанию aliceai-llm-flash; дополняется каталогом до gpt://<каталог>/<модель>
LLM_MODEL=
LLM_FOLDER_ID=
LLM_API_KEY=
# on | off; пусто — on, если модель настроена
LLM_MODE=
# Модель разбора намерения (маршрут D); по умолчанию aliceai-llm-flash
LLM_INTENT_MODEL=
# Резервная модель разбора при сбое основной (например qwen3.6-35b-a3b); пусто — без резерва
LLM_FALLBACK_MODEL=
# Модель LLM-судьи оценки (go run . judge): другого семейства, чем разбор и агент; пусто — qwen3.6-35b-a3b
LLM_JUDGE_MODEL=

# Агент SearchOps: модель (по умолчанию aliceai-llm-flash — нативные вызовы инструментов), запуск по расписанию
# (on/off, по умолчанию off) и интервал, порог допуска правки по регрессии и наборы регрессии (test запрещён).
AGENT_MODEL=
AGENT_SCHEDULE=
AGENT_SCHEDULE_INTERVAL=
AGENT_MAX_REGRESSION_WORSE=
AGENT_REGRESSION_SETS=

# --- Защита стенда ---
# Служебные методы /api/admin/* (переключение LLM_MODE без перезапуска): on | off; пусто — on в development, off в production
ADMIN_ENABLED=
# Запросов к /api в минуту с одного адреса; пусто — 600, 0 — без лимита
RATE_LIMIT_PER_MIN=
# Потолок расхода на модель за сутки (МСК), ₽; пусто — 1000, 0 — без потолка. Сверх — маршрут D на правилах и кэше
LLM_DAILY_BUDGET_RUB=
