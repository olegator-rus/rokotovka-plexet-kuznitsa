# Переменные API для локальной разработки. `make env` копирует файл в backend/.env и подставляет
# DATABASE_URL со случайным паролем dev-базы. Значений секретов в репозитории быть не должно.

APP_ENV=development
# Адрес API; пусто — 127.0.0.1:8088
PORT=
# Пусто в development — API стартует без базы, health отдаёт db: down
DATABASE_URL=
# Пусто в development — http://localhost:5177 (Vite)
PUBLIC_ORIGIN=
# IP или CIDR обратного прокси через запятую; в development не нужен
TRUSTED_PROXIES=

# --- Поиск ---
# Адреса сервисов: строка не задана (закомментирована) — в development локальный адрес по умолчанию
# (OpenSearch http://127.0.0.1:9201, модели http://127.0.0.1:8089); пусто или off — сервис выключен.
# OPENSEARCH_URL=
# EMBEDDER_URL=
# RERANKER_URL=
# Доля реранкера в релевантности на маршрутах C/D (0–1); не задано — 0.45, off — выключен
# SEARCH_RERANK_WEIGHT=
# Кэш векторов запросов и оценок реранкера: записей (по умолчанию 4096, 0 — без кэша) и срок (по умолчанию 6h)
# SEARCH_MODEL_CACHE_SIZE=
# SEARCH_MODEL_CACHE_TTL=
# Каталог mock-данных для импорта; по умолчанию ../data/mock
# DATA_DIR=
# Источник данных: mock (JSON контракта из DATA_DIR) | generic (любые таблицы по файлу сопоставления)
# DATA_SOURCE=
# Файл сопоставления для generic; пример — data/mapping.example.yaml
# DATA_MAPPING=
# Алиас индекса каталога в OpenSearch; по умолчанию products (свой — чтобы проверить чужие данные отдельно)
# INDEX_ALIAS=

# --- LLM (Yandex AI Studio, OpenAI-совместимый API) ---
# openai-compatible | none; пусто — openai-compatible, если задан ключ
LLM_PROVIDER=
# По умолчанию https://ai.api.cloud.yandex.net/v1
LLM_BASE_URL=
# По умолчанию aliceai-llm-flash; дополняется каталогом до gpt://<каталог>/<модель>
LLM_MODEL=
LLM_FOLDER_ID=
LLM_API_KEY=
# on | off; пусто — on, если модель настроена
LLM_MODE=
# Модель разбора намерения (маршрут D); по умолчанию aliceai-llm-flash
LLM_INTENT_MODEL=
# Резервная модель разбора при сбое основной (например qwen3.6-35b-a3b); пусто — без резерва
LLM_FALLBACK_MODEL=
# Модель LLM-судьи оценки (go run . judge): другого семейства, чем разбор и агент; пусто — qwen3.6-35b-a3b
LLM_JUDGE_MODEL=

# Агент SearchOps: модель (по умолчанию aliceai-llm-flash — нативные вызовы инструментов), запуск по расписанию
# (on/off, по умолчанию off) и интервал, порог допуска правки по регрессии и наборы регрессии (test запрещён).
AGENT_MODEL=
AGENT_SCHEDULE=
AGENT_SCHEDULE_INTERVAL=
AGENT_MAX_REGRESSION_WORSE=
AGENT_REGRESSION_SETS=

# --- Защита стенда ---
# Служебные методы /api/admin/* (переключение LLM_MODE без перезапуска): on | off; пусто — on в development, off в production
ADMIN_ENABLED=
# Запросов к /api в минуту с одного адреса; пусто — 600, 0 — без лимита
RATE_LIMIT_PER_MIN=
# Потолок расхода на модель за сутки (МСК), ₽; пусто — 1000, 0 — без потолка. Сверх — маршрут D на правилах и кэше
LLM_DAILY_BUDGET_RUB=
# Часть бюджета, которую разборы покупателей не тратят — остаётся агенту, ₽; пусто — 100
AGENT_BUDGET_RESERVE_RUB=
# Квота разборов LLM (маршрут D, промахи кэша) на адрес покупателя за сутки, ₽; пусто — 20, 0 — без квоты.
# Сверх — правила и кэш, в трассе причина ip_quota
LLM_PER_IP_DAILY_RUB=
# Токен бэк-офиса (не короче 24 символов): Authorization: Bearer <токен> для скриптов и CLI (полный доступ, роль
# system) и ключ подписи сессий. Пусто — ключ сессий случайный на процесс (после перезапуска API нужно войти
# снова; только development; в production обязателен)
BACKOFFICE_TOKEN=

# Вход по ролям. Бэк-офис только после входа сотрудника: on | off; пусто — on. off без
# BACKOFFICE_TOKEN — бэк-офис открыт, как до входа по ролям (только development)
AUTH_REQUIRED=
# Кнопки демо-аккаунтов на /login: on | off; пусто — on в development, off в production
DEMO_LOGIN_BUTTONS=
# Аккаунты по паролю через запятую: login:role[:client_id]:bcrypt-хэш (role — buyer|ecom|product|content|head,
# client_id — только у buyer); в одинарных кавычках. Пусто — только демо-вход и Bearer
AUTH_ACCOUNTS=
# Срок сессии (Go duration, 1m–720h); пусто — 12h
AUTH_SESSION_TTL=
# Неудачных попыток входа в минуту с адреса; пусто — 10, 0 — без лимита
AUTH_LOGIN_PER_MIN=

# Контур коммерции: флаги on|off; не задано — hardware/companions/margin_policy on, solutions off
FEATURE_HARDWARE=
FEATURE_COMPANIONS=
FEATURE_MARGIN_POLICY=
FEATURE_SOLUTIONS=
# Контур выдачи, панель поиска: on|off; не задано — panel/products/margin/recs on, viewed off
FEATURE_PANEL=
FEATURE_PANEL_PRODUCTS=
FEATURE_PANEL_MARGIN=
FEATURE_PANEL_RECS=
FEATURE_PANEL_VIEWED=
