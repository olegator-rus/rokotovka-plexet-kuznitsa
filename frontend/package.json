{
  "name": "kuznica-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" \"tests/**/*.ts\"",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@primeuix/themes": "^2.0.3",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.5.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
