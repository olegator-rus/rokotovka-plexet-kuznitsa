# Переменные продакшен-стенда (deploy/docker-compose.yml). Скопировать в .env и заполнить.
# Значений в репозитории быть не должно.

# --- Домен и TLS (Caddy) ---
DOMAIN=
ACME_EMAIL=

# --- PostgreSQL ---
POSTGRES_DB=kuznica
POSTGRES_USER=kuznica
POSTGRES_PASSWORD=            # openssl rand -hex 24

# --- API ---
TRUSTED_PROXIES=              # подсеть сети compose, из которой ходит Caddy (IP или CIDR через запятую)
