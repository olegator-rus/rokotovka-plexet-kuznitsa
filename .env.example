# Переменные продакшен-стенда (deploy/docker-compose.yml). Скопировать в .env и заполнить.
# Значений в репозитории быть не должно.

# --- Домен и TLS (Caddy) ---
DOMAIN=
ACME_EMAIL=

# --- PostgreSQL ---
POSTGRES_DB=kuznica
POSTGRES_USER=kuznica
POSTGRES_PASSWORD=            # openssl rand -hex 24

# --- API ---
TRUSTED_PROXIES=              # подсеть сети compose, из которой ходит Caddy (IP или CIDR через запятую)

# --- Поиск и модели (пусто — шаг выключен) ---
OPENSEARCH_URL=
EMBEDDER_URL=
RERANKER_URL=

# --- LLM (Yandex AI Studio) ---
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_FOLDER_ID=
LLM_API_KEY=
LLM_MODE=
LLM_INTENT_MODEL=
LLM_FALLBACK_MODEL=
# Модель LLM-судьи оценки (go run . judge): другого семейства, чем разбор и агент; пусто — qwen3.6-35b-a3b
LLM_JUDGE_MODEL=

# --- Защита стенда ---
# Служебные методы /api/admin/* (LLM_MODE без перезапуска): on | off; пусто — off в production
ADMIN_ENABLED=
# Запросов к /api в минуту с адреса; пусто — 600, 0 — без лимита
RATE_LIMIT_PER_MIN=
# Потолок расхода на модель за сутки (МСК), ₽; пусто — 1000, 0 — без потолка
LLM_DAILY_BUDGET_RUB=
