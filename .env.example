# Переменные продакшен-стенда (deploy/docker-compose.yml). Скопировать в .env и заполнить.
# Значений в репозитории быть не должно.

# --- Домен и TLS (Caddy) ---
DOMAIN=
ACME_EMAIL=

# --- PostgreSQL ---
POSTGRES_DB=kuznica
POSTGRES_USER=kuznica
POSTGRES_PASSWORD=            # openssl rand -hex 24

# --- API ---
TRUSTED_PROXIES=              # подсеть сети compose, из которой ходит Caddy (IP или CIDR через запятую)

# --- Поиск и модели (пусто — шаг выключен) ---
OPENSEARCH_URL=
EMBEDDER_URL=
RERANKER_URL=
# Доля реранкера в релевантности на маршрутах C/D (0–1); пусто — 0.45, off — выключен
SEARCH_RERANK_WEIGHT=
# Кэш векторов запросов и оценок реранкера: записей (по умолчанию 4096, 0 — без кэша) и срок (по умолчанию 6h)
SEARCH_MODEL_CACHE_SIZE=
SEARCH_MODEL_CACHE_TTL=

# --- LLM (Yandex AI Studio) ---
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_FOLDER_ID=
LLM_API_KEY=
LLM_MODE=
LLM_INTENT_MODEL=
LLM_FALLBACK_MODEL=
# Модель LLM-судьи оценки (go run . judge): другого семейства, чем разбор и агент; пусто — qwen3.6-35b-a3b
LLM_JUDGE_MODEL=

# --- Защита стенда ---
# Служебные методы /api/admin/* (LLM_MODE без перезапуска): on | off; пусто — off в production
ADMIN_ENABLED=
# Запросов к /api в минуту с адреса; пусто — 600, 0 — без лимита
RATE_LIMIT_PER_MIN=
# Потолок расхода на модель за сутки (МСК), ₽; пусто — 1000, 0 — без потолка
LLM_DAILY_BUDGET_RUB=
# Часть бюджета, которую разборы покупателей не тратят — остаётся агенту, ₽; пусто — 100
AGENT_BUDGET_RESERVE_RUB=
# Квота разборов LLM (маршрут D, промахи кэша) на адрес покупателя за сутки, ₽; пусто — 20, 0 — без квоты
LLM_PER_IP_DAILY_RUB=

# --- Вход в бэк-офис (обязателен) ---
# Токен бэк-офиса: пароль входа в браузере и Bearer для скриптов. openssl rand -hex 24
BACKOFFICE_TOKEN=
# Имя для входа в браузере; пусто — manager
BACKOFFICE_USER=
# bcrypt-хэш токена в base64 для Caddy:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext "<BACKOFFICE_TOKEN>" | tr -d '\n' | base64 | tr -d '\n'
BACKOFFICE_HASH=
