# Переменные продакшен-стенда (deploy/docker-compose.yml). Скопировать в .env и заполнить.
# Значений в репозитории быть не должно.

# --- Домен и TLS (Caddy) ---
DOMAIN=
ACME_EMAIL=

# --- PostgreSQL ---
POSTGRES_DB=kuznica
POSTGRES_USER=kuznica
POSTGRES_PASSWORD=            # openssl rand -hex 24

# --- API ---
TRUSTED_PROXIES=              # подсеть сети compose, из которой ходит Caddy (IP или CIDR через запятую)

# --- Поиск и модели (пусто — шаг выключен) ---
OPENSEARCH_URL=
EMBEDDER_URL=
RERANKER_URL=
# Доля реранкера в релевантности на маршрутах C/D (0–1); пусто — 0.45, off — выключен
SEARCH_RERANK_WEIGHT=
# Кэш векторов запросов и оценок реранкера: записей (по умолчанию 4096, 0 — без кэша) и срок (по умолчанию 6h)
SEARCH_MODEL_CACHE_SIZE=
SEARCH_MODEL_CACHE_TTL=

# --- LLM (Yandex AI Studio) ---
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_FOLDER_ID=
LLM_API_KEY=
LLM_MODE=
LLM_INTENT_MODEL=
LLM_FALLBACK_MODEL=
# Модель LLM-судьи оценки (go run . judge): другого семейства, чем разбор и агент; пусто — qwen3.6-35b-a3b
LLM_JUDGE_MODEL=

# --- Защита стенда ---
# Служебные методы /api/admin/* (LLM_MODE без перезапуска): on | off; пусто — off в production
ADMIN_ENABLED=
# Запросов к /api в минуту с адреса; пусто — 600, 0 — без лимита
RATE_LIMIT_PER_MIN=
# Потолок расхода на модель за сутки (МСК), ₽; пусто — 1000, 0 — без потолка
LLM_DAILY_BUDGET_RUB=
# Часть бюджета, которую разборы покупателей не тратят — остаётся агенту, ₽; пусто — 100
AGENT_BUDGET_RESERVE_RUB=
# Квота разборов LLM (маршрут D, промахи кэша) на адрес покупателя за сутки, ₽; пусто — 20, 0 — без квоты
LLM_PER_IP_DAILY_RUB=

# --- Вход в бэк-офис (обязателен) ---
# Токен бэк-офиса: Bearer для скриптов и CLI (полный доступ) и ключ подписи сессий. openssl rand -hex 24
BACKOFFICE_TOKEN=

# --- Вход по ролям ---
# Бэк-офис только после входа сотрудника: on | off; пусто — on (в production off запрещено)
AUTH_REQUIRED=
# Кнопки демо-аккаунтов на /login (вымышленные покупатели и сотрудники): on | off; пусто — off в production.
# Для стенда жюри — on
DEMO_LOGIN_BUTTONS=
# Аккаунты по паролю через запятую: login:role[:client_id]:bcrypt-хэш (role — buyer|ecom|product|content|head,
# client_id — только у buyer). Значение — в одинарных кавычках (в хэше есть $). Хэш:
#   htpasswd -bnBC 10 "" '<пароль>' | tr -d ':\n'
AUTH_ACCOUNTS=
# Срок сессии (Go duration); пусто — 12h
AUTH_SESSION_TTL=
# Неудачных попыток входа в минуту с адреса; пусто — 10, 0 — без лимита
AUTH_LOGIN_PER_MIN=

# --- Второй замок Caddy (необязательно; блок basic_auth в deploy/Caddyfile закомментирован) ---
# Имя для basic_auth; пусто — manager
BACKOFFICE_USER=
# bcrypt-хэш BACKOFFICE_TOKEN в base64 для Caddy:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext "<BACKOFFICE_TOKEN>" | tr -d '\n' | base64 | tr -d '\n'
BACKOFFICE_HASH=

# Контур коммерции: флаги on|off; не задано — hardware/companions/margin_policy on, solutions off
FEATURE_HARDWARE=
FEATURE_COMPANIONS=
FEATURE_MARGIN_POLICY=
FEATURE_SOLUTIONS=
# Контур выдачи, панель поиска: on|off; не задано — panel/products/margin/recs on, viewed off
FEATURE_PANEL=
FEATURE_PANEL_PRODUCTS=
FEATURE_PANEL_MARGIN=
FEATURE_PANEL_RECS=
FEATURE_PANEL_VIEWED=
