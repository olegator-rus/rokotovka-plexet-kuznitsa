# syntax=docker/dockerfile:1
# Контекст сборки — корень репозитория. SPA собирается с относительным /api: Caddy раздаёт
# статику и проксирует /api на тот же origin.
FROM node:22-alpine AS build
WORKDIR /src
# pnpm через corepack — версия из поля packageManager в frontend/package.json.
RUN corepack enable
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ .
# `pnpm build` = vue-tsc -b && vite build: сборка падает на ошибке типов.
RUN pnpm build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/dist /srv
