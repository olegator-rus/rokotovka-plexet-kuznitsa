# syntax=docker/dockerfile:1
# Контекст сборки — корень репозитория (deploy/docker-compose.yml: context ..).
# Версия образа соответствует backend/go.mod (go 1.27.4).
FROM golang:1.27.4-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates tzdata
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/api .

FROM alpine:3.20
# wget — для healthcheck в compose; tzdata — Europe/Moscow; tesseract-ocr с языками rus и eng (Apache-2.0) —
# распознавание сканов ТЗ, запасной путь к Yandex Vision OCR (контур ТЗ, backend/externalApi/ocr/tesseract.go).
RUN apk add --no-cache ca-certificates tzdata wget tesseract-ocr tesseract-ocr-data-rus tesseract-ocr-data-eng && \
    adduser -D -u 10001 app
COPY --from=build /out/ /app/
USER app
WORKDIR /app
ENV PORT=0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["/app/api"]
